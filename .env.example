# Copy to .env and fill in. .env is gitignored; never commit it, print it or paste it into chat.

# Sail Research inference (OpenAI-compatible). Used from phase 4.
SAIL_BASE_URL=https://api.sailresearch.com/v1
SAIL_API_KEY=
SAIL_MODEL_WRITER=zai-org/GLM-5.3
SAIL_MODEL_JUDGE=zai-org/GLM-5.3
SAIL_SERVICE_TIER=asap

# SEC EDGAR fair-access User-Agent: your name and a contact email, e.g. "Jane Doe jane@example.com".
# The EDGAR client refuses to run without it.
EDGAR_USER_AGENT=
